{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vinext-aborts.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vinext build",
    "start": "vinext start",
    "start:prod": "vinext start --port 5013 --hostname 127.0.0.1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify:operations": "node scripts/verify-operations.mjs",
    "verify:feishu": "node scripts/verify-feishu.mjs",
    "verify:dashboards": "node scripts/test-dashboard-feedback.mjs && node scripts/verify-growth.mjs && node scripts/test-workspace-charts.mjs && node scripts/test-content-comment-boards.mjs && node scripts/test-acceptance-reply-pending.mjs && node scripts/test-ui-unification-v1-regression.mjs && node scripts/test-category-notes-modal.mjs",
    "verify:styles": "node scripts/test-computed-styles.mjs",
    "db:generate": "drizzle-kit generate",
    "verify:xlsx": "node scripts/test-xlsx-loader.mjs",
    "verify:matrix": "node scripts/verify-platform-v1.mjs",
    "verify:closure": "node scripts/verify-frontend-closure.mjs",
    "verify:reconcile": "node scripts/reconcile-qicui.mjs",
    "migrate:v1": "node scripts/migrate-to-v1.mjs",
    "migrate:delivery": "node scripts/migrate-delivery-project.mjs",
    "verify:migration": "node scripts/test-delivery-migration.mjs",
    "verify:e2e": "node node_modules/@playwright/test/cli.js test",
    "verify:unit": "node scripts/test-v3-remediation.mjs",
    "verify:api": "node scripts/test-v3-api.mjs",
    "verify:focused:unit": "node scripts/test-focused-remediation.mjs",
    "verify:focused:api": "node scripts/test-focused-api.mjs",
    "verify:focused:browser": "node node_modules/@playwright/test/cli.js test tests/browser/focused-red.spec.ts tests/browser/focused.spec.ts",
    "verify:unit-api:v2": "node scripts/verify-v2-unit-api.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
